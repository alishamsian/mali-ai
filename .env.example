# Copy to .env (gitignored) and fill in from Supabase → Project Settings → API.
# Both values ship inside the app and are public by design; Row Level Security protects
# the data. Never put the service_role key in the mobile app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# After changing these, restart Metro with: npm start -- --reset-cache

# Optional: HTTPS address of version.json for the in-app update check (leave empty to turn it off)
UPDATE_MANIFEST_URL=

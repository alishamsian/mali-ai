<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2: allowance on the right, today and month on the left, add + voice buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layoutDirection="rtl"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/widget_brand"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:gravity="center"
                    android:text="پ"
                    android:textColor="@color/widget_on_btn"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/widget_kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/widget_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autoSizeMaxTextSize="32sp"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/vazirmatn_bold"
                android:gravity="start"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="30sp" />
            <TextView
                android:id="@+id/widget_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_regular"
                android:gravity="start"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
            <ProgressBar
                android:id="@+id/widget_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_today_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_regular"
                android:gravity="start"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_bold"
                android:gravity="start"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/widget_month_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/vazirmatn_regular"
                android:gravity="start"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_bold"
                android:gravity="start"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:layoutDirection="rtl"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center"
            android:text="+  ثبت خرج"
            android:textColor="@color/widget_on_btn"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_voice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_ghost"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center"
            android:text="ثبت با صدا"
            android:textColor="@color/widget_ghost_text"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>

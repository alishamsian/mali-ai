{
  "name": "mali-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-gradle-mirrors.js",
    "android": "react-native run-android",
    "preview": "python3 -m http.server 4173 --directory preview --bind 0.0.0.0",
    "apk": "cd android && ./gradlew assembleRelease && cp app/build/outputs/apk/release/app-release.apk ../preview/mali-ai.apk",
    "aab": "cd android && ./gradlew bundleRelease && cp app/build/outputs/bundle/release/app-release.aab ../preview/mali-ai.aab",
    "bank-logos": "python3 scripts/fetch-bank-logos.py",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start": "react-native start",
    "test": "jest",
    "sms:test": "jest --testPathPattern='sms/(tests|fixtures)' --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.6",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.25",
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "2.2.12",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.87.4",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.18",
    "jalaliday": "^3.0.0",
    "js-sha256": "^0.11.1",
    "lucide-react-native": "0.468.0",
    "react": "19.1.0",
    "react-hook-form": "^7.62.0",
    "react-native": "0.81.1",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-get-random-values": "2.0.0",
    "react-native-keychain": "^9.2.3",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^3.3.1",
    "react-native-reanimated": "3.19.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.15.4",
    "react-native-svg": "^15.13.0",
    "react-native-url-polyfill": "4.0.0",
    "victory-native": "41.20.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.81.1",
    "@react-native/eslint-config": "0.81.1",
    "@react-native/metro-config": "0.81.1",
    "@react-native/typescript-config": "0.81.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
